# AWS
.aws-sam/
samconfig.toml

# Generated by scripts/create-aips.sh: maps (business unit, model) to the
# Application Inference Profile ARNs in whichever account you deployed to.
# Account-specific derived state, not source. config/bu-models.json is the source.
.aip-map.json

# Generated by deploy.sh Step 9 from CloudFormation outputs. Contains account-specific
# identifiers and an API Gateway key, so it is not source.
# See frontend/public/config.example.js for the expected shape.
frontend/public/config.js

# Local code-review reports. Useful while working, not a project deliverable.
semantic-review/

# draw.io desktop app temp/autosave files
docs/*.dtmp
docs/*.bkp
